# Copy to .env on ZGX (never commit). Naman fills values.

CS_TWILIO_ENABLED=0
CS_KILL_SWITCH=0

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
CS_DEMO_TO_NUMBER=
# Public HTTPS base Twilio can reach (Tailscale Funnel / ngrok)
CS_PUBLIC_BASE=

# Optional local serves (when ready)
