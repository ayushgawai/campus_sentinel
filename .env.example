# Copy to .env on ZGX (never commit).

CS_SIGNALWIRE_ENABLED=0
CS_KILL_SWITCH=0

SIGNALWIRE_SPACE=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_FROM=
CS_DEMO_TO_NUMBER=
# Public HTTPS base SignalWire can reach (Tailscale Funnel / ngrok)
CS_PUBLIC_BASE=

# Optional local serves (when ready)
# CS_PARAKEET_URL=http://127.0.0.1:8091/transcribe
# CS_KOKORO_URL=http://127.0.0.1:8092/synthesize

# Optional phone TTS: ElevenLabs (ulaw_8000) with automatic Kokoro fallback.
# Free tier = 10,000 characters/month. Default provider is kokoro.
# CS_TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# CS_ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# CS_ELEVENLABS_MODEL=eleven_flash_v2_5
# CS_ELEVENLABS_TIMEOUT_S=4

# Seville clip folder for the wall and YOLO (15 fps interpolated pack on the ZGX)
CS_MEDIA_ROOT=
# History database (default data/runtime/sentinel.db)
CS_DB_PATH=
